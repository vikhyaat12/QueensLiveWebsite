/* Branded route-level loading state — no blank screens while data loads. */
export default function Loading() {
  return (
    <main
      aria-busy="true"
      aria-label="Loading"
      style={{
        minHeight: "60vh",
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "center",
        gap: 18,
        background: "#FBFAFE",
        fontFamily: "var(--font-geist, system-ui, sans-serif)",
      }}
    >
      <div style={{ display: "flex", gap: 8, alignItems: "center" }} aria-hidden="true">
        {[0, 1, 2].map(i => (
          <span
            key={i}
            style={{
              width: 8,
              height: 8,
              borderRadius: "50%",
              background: i === 1 ? "#D4AF37" : "#2A0F3A",
              opacity: 0.85,
              animation: `qcPageLoad 1.1s ease-in-out ${i * 0.16}s infinite`,
            }}
          />
        ))}
      </div>
      <style>{`
        @keyframes qcPageLoad {
          0%, 100% { transform: translateY(0); opacity: 0.45; }
          50% { transform: translateY(-6px); opacity: 1; }
        }
        @media (prefers-reduced-motion: reduce) {
          [aria-busy="true"] span { animation: none !important; }
        }
      `}</style>
      <p style={{ margin: 0, fontSize: 10, fontWeight: 700, letterSpacing: "0.17em", textTransform: "uppercase", color: "#8a6a45" }}>
        Preparing your care
      </p>
    </main>
  );
}
